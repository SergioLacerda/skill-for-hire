{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsforhire.dev/schemas/lockfile.schema.json",
  "title": "Skills for Hire — skillhire.lock",
  "description": "Consumer-side lockfile pinning installed skills to exact versions and digests. Generated by `skillhire lock`; edited manually only under review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "installed"],
  "properties": {
    "schema-version": { "const": 1 },
    "generator": {
      "type": "string",
      "description": "Tool that produced the lockfile (e.g. \"skillhire@0.1.0\")."
    },
    "installed": {
      "type": "object",
      "description": "Map from skill name to its resolved pin.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["version", "digest", "source"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "description": "SemVer of the pinned release."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "source": {
            "type": "string",
            "description": "Where the release came from (e.g. \"monorepo:skills/atlas\", \"github-release:SergioLacerda/skill-for-hire@v0.1.0\")."
          },
          "resolved-from": {
            "type": "string",
            "description": "Sidecar release.yaml manifest the pin was derived from."
          }
        }
      }
    }
  }
}
